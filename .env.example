# ============================================
# ASTRO-GUARDIAN — ENVIRONMENT VARIABLES
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file to apps/api/.env
#    Command: cp .env.example apps/api/.env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# ---------------------------
# GitHub App
# ---------------------------
# Created at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------
# Session
# ---------------------------
SESSION_SECRET=

# ---------------------------
# Database (PostgreSQL)
# ---------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ---------------------------
# URLs
# ---------------------------
# Public-facing API base URL (used in OAuth callback redirect)
API_URL=
# Public-facing frontend URL (used in CORS + post-login redirect)
FRONTEND_URL=

# ---------------------------
# IBM Bob Shell CLI
# ---------------------------
# Get from: https://cloud.ibm.com/iam/apikeys
BOBSHELL_API_KEY=

# ---------------------------
# watsonx.ai
# ---------------------------
# IBM Cloud API key (IAM): https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=
# Project ID from watsonx.ai Studio → project → Manage → General
WATSONX_PROJECT_ID=
# Regional endpoint, e.g. https://us-south.ml.cloud.ibm.com
WATSONX_URL=

# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use process.env.VARIABLE_NAME to access values
# - Never share credentials with AI assistants like Bob
# ============================================
